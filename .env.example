# Copy to .env and fill in values before running.

# Happs backend
HAPPS_API_BASE=http://triangulum.cc:46695/api/
HAPPS_SCRAPER_TOKEN=change-me          # must match SCRAPER_TOKEN in the Django backend

# AI fallback (leave blank to disable AI extraction)
ANTHROPIC_API_KEY=

# Scraper behaviour
# PAGE_MAX_AGE_DAYS=7                 # refetch a detail page this old even if nothing says it changed
# DEFAULT_EVENT_TIMEZONE=America/New_York  # zone for naive dates when a source has none
# REVIEW_THRESHOLD=0.7                 # confidence below which events are held for review
# SNAPSHOTS_ENABLED=true              # save pages for review in the backend (tools/review.py sync)
# SNAPSHOT_SAMPLE_RATE=0.01            # share of unremarkable pages saved too
# HTTPCACHE_ENABLED=true               # uncomment during development to cache responses

# Crawler pool (tools/worker.py, compose.yaml)
# WORKER_MAX_CRAWLERS=4                # crawlers at once; ~1.5 GB of memory each with Playwright
# WORKER_SOURCES_PER_CRAWLER=20        # one crawler per this many due sources
# WORKER_BUDGET_MINUTES=30             # a crawler stops claiming after this long, then reports
