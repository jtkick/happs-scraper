# Copy to .env and fill in values before running.

# Happs backend
HAPPS_API_BASE=http://triangulum.cc:46695/api/
HAPPS_SCRAPER_TOKEN=change-me          # must match SCRAPER_TOKEN in the Django backend

# AI fallback (leave blank to disable AI extraction)
ANTHROPIC_API_KEY=

# Scraper behaviour
ETAG_DB_PATH=etags.db                  # local ETag cache (optional; safe to lose)
# DEFAULT_EVENT_TIMEZONE=America/New_York  # zone for naive dates when a source has none
# REVIEW_THRESHOLD=0.7                 # confidence below which events are held for review
# HTTPCACHE_ENABLED=true               # uncomment during development to cache responses
